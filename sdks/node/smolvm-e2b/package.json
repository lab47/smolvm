{
  "name": "@smolvm/e2b",
  "version": "0.1.0",
  "description": "Self-hosted, e2b-shaped sandbox SDK backed by smolvm microVMs (HTTP client for `smolvm serve`)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../node_modules/.bin/tsup",
    "dev": "../node_modules/.bin/tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "../node_modules/.bin/tsc --noEmit",
    "test": "../node_modules/.bin/vitest run",
    "test:integration": "../node_modules/.bin/vitest run integration-tests",
    "example:basic": "../node_modules/.bin/tsx examples/basic.ts",
    "example:ifconfig": "../node_modules/.bin/tsx examples/ifconfig.ts",
    "example:preview": "../node_modules/.bin/tsx examples/remote-preview.ts",
    "example:build-template": "../node_modules/.bin/tsx examples/build-template.ts"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "keywords": [
    "smolvm",
    "e2b",
    "sandbox",
    "microvm",
    "code-interpreter",
    "self-hosted"
  ],
  "license": "Apache-2.0"
}
